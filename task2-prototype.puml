@startuml task2-prototype
title Ситуація 2. План обстеження й лікування — Prototype
skinparam classAttributeIconSize 0

interface "Prototype<T>" as Prototype <<Prototype>> {
  + copy() : T
}

class TreatmentPlan <<ConcretePrototype>> {
  - protocolName : String
  - patientName : String
  - analyses : List<String>
  - procedures : List<String>
  - prescriptions : List<String>
  - diet : String
  - regime : String
  - TreatmentPlan(...)
  + {static} buildFromProtocol(...) : TreatmentPlan
  + copy() : TreatmentPlan
  + setPatientName(name : String)
  + addPrescription(p : String)
  + removePrescription(p : String) : boolean
  + setDiet(diet : String)
  + setRegime(regime : String)
  + describe() : String
}

class PlanTemplateRegistry <<PrototypeRegistry>> {
  - templates : Map<String, TreatmentPlan>
  + register(key : String, t : TreatmentPlan)
  + createFor(key : String, patient : Patient) : TreatmentPlan
  + getTemplate(key : String) : TreatmentPlan
}

class Patient {
  - fullName : String
  - department : String
  - diagnosis : String
  - attendingDoctor : String
}

class Main <<Client>> {
  ~ {static} situation2Prototype()
}

note bottom of TreatmentPlan
  copy() створює глибоку копію: списки
  аналізів, процедур і призначень
  дублюються. Дороге складання плану
  за протоколом виконується один раз.
end note

Prototype <|.. TreatmentPlan
PlanTemplateRegistry "1" o-- "0..*" TreatmentPlan : зберігає типові плани
PlanTemplateRegistry ..> Patient : <<use>>
TreatmentPlan ..> TreatmentPlan : <<create>> copy()
Main ..> PlanTemplateRegistry : <<use>>
Main ..> TreatmentPlan : коригує копію
@enduml
