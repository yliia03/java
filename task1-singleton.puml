@startuml task1-singleton
title Ситуація 1. Реєстр ліжкового фонду — Singleton
skinparam classAttributeIconSize 0

class BedRegistry <<Singleton>> {
  - {static} createdInstances : int
  - beds : List<Bed>
  - BedRegistry()
  + {static} getInstance() : BedRegistry
  + {static} getCreatedInstances() : int
  + admit(patient : Patient) : Optional<Bed>
  + discharge(patient : Patient) : boolean
  + freeCount(department : String) : long
}

class "BedRegistry.Holder" as Holder <<Lazy holder>> {
  - {static} INSTANCE : BedRegistry
}

class Bed {
  - wardNumber : String
  - department : String
  - state : BedState
  - patient : Patient
  + isFree() : boolean
  ~ occupy(p : Patient)
  ~ release()
}

enum BedState {
  FREE
  OCCUPIED
}

class Patient {
  - fullName : String
  - department : String
  - diagnosis : String
  - attendingDoctor : String
}

class Main <<Client>> {
  ~ {static} situation1Singleton()
}

note right of BedRegistry
  Приватний конструктор + єдина точка
  доступу getInstance(): приймальне та
  профільні відділення бачать один фонд.
end note

BedRegistry "1" *-- "5..*" Bed : містить >
Bed --> "1" BedState
Bed "0..1" --> "0..1" Patient : зайняте пацієнтом
BedRegistry ..> Patient : <<use>>
Holder ..> BedRegistry : створює єдиний екземпляр
BedRegistry ..> Holder : <<use>> getInstance()
Main ..> BedRegistry : <<use>> getInstance()
@enduml
